{
  "name": "ecommerce-knowledgebase-scraper",
  "version": "0.0.1",
  "description": "Scrapes ecommerce websites (Shopify-first) to output structured product data and RAG-ready knowledge chunks.",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "npm run start:prod",
    "start:prod": "node dist/main.js",
    "start:dev": "node --no-warnings --loader ts-node/esm src/main.ts",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "apify": "^3.1.10",
    "crawlee": "^3.5.7",
    "cheerio": "^1.0.0-rc.12",
    "turndown": "^7.1.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@apify/tsconfig": "^0.1.0",
    "@types/node": "^20.8.2",
    "@types/turndown": "^5.0.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
